export class FixedClock implements Clock {
  calls = 0;
  slept: number[] = [];
  constructor(
    public start: Now = START,
    public stepMs = 0,
  ) {}
  now(): Now {
    this.calls += 1;
    return { ...this.start, epochMs: this.start.epochMs + this.stepMs * (this.calls - 1) };
  }
  async sleep(seconds: number): Promise<void> {
    this.slept.push(seconds);
    this.start = { ...this.start, epochMs: this.start.epochMs + seconds * 1000 };
  }
}
export class CountingIds implements IdSource {
  draws = 0;
  next: number;
  constructor(
    first = 1,
    public step = 1,
  ) {
    this.next = first;
  }
  entropy(): Uint8Array {
    this.draws += 1;
    const value = this.next;
    this.next += this.step;
    if (!Number.isInteger(value) || value < 0 || value > 255)
      throw new RangeError("byte must be in range(0, 256)");
    return new Uint8Array(6).fill(value);
  }
}
import {
  type Clock,
  CommitOutcome,
  committed,
  gate,
  type Held,
  type HeldDraft,
  LodgeError,
  NotFound,
  PublishOutcome,
  type Store,
  stampOf,
} from "#app";
import { ATTACHMENTS, decodeUtf8, encodeUtf8, type Tree, ValueError } from "#core";
import { appendEvents, json } from "./events.ts";
import { readTree, touchHead } from "./read-tree.ts";
import type { LodgeDatabase } from "./schema.ts";
export class SqliteStore implements Store {
  constructor(
    private readonly database: LodgeDatabase,
    private readonly project: string,
    private readonly actor: string,
    private readonly clock: Clock,
  ) {}
  async hold(held: HeldDraft): Promise<number> {
    return this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, this.project)))
        throw new NotFound(`no project named ${this.project}`);
      return appendEvents(tx, this.project, this.actor, stampOf(this.clock.now()), [
        { kind: "held", path: null, body: json(held), message: null },
      ]);
    });
  }
  async held(): Promise<readonly Held[]> {
    const rows = await this.database.db
      .selectFrom("held")
      .selectAll()
      .where("project", "=", this.project)
      .where("state", "=", "open")
      .orderBy("seq", "asc")
      .execute();
    return rows.map((row) => ({
      ...(JSON.parse(decodeUtf8(row.body)) as HeldDraft),
      seq: row.seq,
      at: row.at,
    }));
  }
  async decline(seq: number, reason: string): Promise<void> {
    await this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, this.project)))
        throw new NotFound(`no project named ${this.project}`);
      const held = await tx
        .selectFrom("held")
        .select("seq")
        .where("seq", "=", seq)
        .where("project", "=", this.project)
        .where("state", "=", "open")
        .executeTakeFirst();
      if (!held) throw new NotFound(`nothing is held under number ${seq}`);
      await appendEvents(tx, this.project, this.actor, stampOf(this.clock.now()), [
        { kind: "declined", path: null, body: json({ held: seq, reason }), message: null },
      ]);
    });
  }
  async trees(): Promise<readonly [Tree, Tree]> {
    return this.database.db.transaction().execute(async (tx) => {
      const current = await readTree(tx, this.project);
      return [current, current] as const;
    });
  }
  async attachmentTexts(): Promise<ReadonlyMap<string, string>> {
    const rows = await this.database.db
      .selectFrom("files")
      .selectAll()
      .where("project", "=", this.project)
      .where("path", ">=", ATTACHMENTS)
      .where("path", "<", "lodge/attachments0")
      .execute();
    return new Map(rows.map((row) => [row.path, decodeUtf8(row.body)]));
  }
  async freshness() {
    return null;
  }
  async gate(current: Tree) {
    return gate({ published: current, checked: [["", current]] });
  }
  async commit(_paths: readonly string[], _message: string) {
    return committed({
      outcome: CommitOutcome.FAILED,
      detail: "the server keeps no checkout; its writes are published at once",
    });
  }
  async publish(
    base: Tree,
    writes: ReadonlyMap<string, string>,
    message: string,
    approves: number | null = null,
  ): Promise<PublishOutcome> {
    const events: { kind: string; path: string; body: Uint8Array; message: string }[] = [];
    for (const path of writes.keys()) {
      const parts = path.split("/");
      if (
        parts[0] !== "lodge" ||
        parts.length < 2 ||
        path.includes("\\") ||
        path.includes("\0") ||
        parts.some((part) => ["", ".", "..", ".git"].includes(part))
      )
        throw new LodgeError(`${path} is outside lodge/, which is all the store writes`);
      if (base.attachments.has(path))
        throw new LodgeError(`${path} is an attachment, and lodge never overwrites an attachment`);
    }
    for (const path of writes.keys()) {
      if (/\p{Cs}/u.test(path))
        throw new LodgeError(`${path}: a path holding a lone surrogate cannot be stored`);
    }
    for (const [path, text] of writes) {
      if (
        path.startsWith("lodge/decisions/") &&
        base.files.has(path) &&
        base.files.get(path) !== text
      )
        throw new LodgeError(
          `${path} is a published decision, and lodge never rewrites a decision`,
        );
    }
    for (const [path, text] of writes) {
      try {
        events.push({ kind: "file", path, body: encodeUtf8(text), message });
      } catch (error) {
        if (!(error instanceof ValueError)) throw error;
        throw new LodgeError(`${path}: ${error.message}`);
      }
    }
    if (base.rev === null || !/^[0-9]+$/u.test(base.rev)) return PublishOutcome.REJECTED;
    return this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, this.project, Number(base.rev)))) return PublishOutcome.REJECTED;
      if (approves !== null) {
        const held = await tx
          .selectFrom("held")
          .select("seq")
          .where("seq", "=", approves)
          .where("project", "=", this.project)
          .where("state", "=", "open")
          .executeTakeFirst();
        if (!held) return PublishOutcome.REJECTED;
      }
      const at = stampOf(this.clock.now());
      await appendEvents(tx, this.project, this.actor, at, events);
      if (approves !== null)
        await appendEvents(tx, this.project, this.actor, at, [
          { kind: "approved", path: null, body: json({ held: approves }), message: null },
        ]);
      return PublishOutcome.PUBLISHED;
    });
  }
}
import type { Transaction } from "kysely";
import { NotFound, Role } from "#app";
import { ATTACHMENTS, decodeUtf8, type Tree, tree } from "#core";
import type { Tables } from "./schema.ts";
export async function headOf(tx: Transaction<Tables>, project: string): Promise<number> {
  const head = await tx
    .selectFrom("heads")
    .select("rev")
    .where("project", "=", project)
    .executeTakeFirst();
  if (!head) throw new NotFound(`no project named ${project}`);
  return head.rev;
}
export async function touchHead(
  tx: Transaction<Tables>,
  project: string,
  rev?: number,
): Promise<boolean> {
  let query = tx
    .updateTable("heads")
    .set((eb) => ({ rev: eb.ref("rev") }))
    .where("project", "=", project);
  if (rev !== undefined) query = query.where("rev", "=", rev);
  const result = await query.executeTakeFirst();
  return result.numUpdatedRows !== 0n;
}
export async function readTree(tx: Transaction<Tables>, project: string): Promise<Tree> {
  const rev = await headOf(tx, project);
  const rows = await tx
    .selectFrom("files")
    .selectAll()
    .where("project", "=", project)
    .orderBy("path", "asc")
    .execute();
  const files = new Map<string, string>(),
    attachments = new Set<string>();
  for (const row of rows) {
    if (row.path.startsWith(ATTACHMENTS)) attachments.add(row.path);
    else files.set(row.path, decodeUtf8(row.body));
  }
  const owners = await tx
    .selectFrom("members")
    .select("person")
    .where("project", "=", project)
    .where("role", "=", Role.OWNER)
    .execute();
  return tree({
    rev: String(rev),
    files,
    attachments,
    people: new Set(owners.map((row) => row.person)),
  });
}
import { afterEach } from "bun:test";
import { type LodgeDatabase, openDatabase, SqliteProjects, SqliteStore } from "#store";
import { FixedClock } from "../app/fakes.ts";

const opened: LodgeDatabase[] = [];
afterEach(async () => {
  for (const db of opened.splice(0)) await db.close();
});
export async function setup() {
  const database = await openDatabase(":memory:");
  opened.push(database);
  const clock = new FixedClock();
  const projects = new SqliteProjects(database, clock);
  await projects.create("storage", "author");
  const store = new SqliteStore(database, "storage", "author", clock);
  return { database, projects, store, clock };
}
export async function events(database: LodgeDatabase) {
  return database.db.selectFrom("events").selectAll().orderBy("seq", "asc").execute();
}
import type { Selectable, Transaction } from "kysely";
import { decodeUtf8, encodeUtf8 } from "#core";
import type { LodgeDatabase, Tables } from "./schema.ts";

interface NewEvent {
  readonly kind: string;
  readonly path: string | null;
  readonly body: Uint8Array;
  readonly message: string | null;
}
export function json(value: unknown): Uint8Array {
  return encodeUtf8(JSON.stringify(value));
}
export async function appendEvents(
  tx: Transaction<Tables>,
  project: string,
  actor: string,
  at: string,
  events: readonly NewEvent[],
): Promise<number> {
  let seq = 0;
  for (const event of events) {
    const row = await tx
      .insertInto("events")
      .values({
        ...event,
        message: event.message === null ? null : encodeUtf8(event.message),
        project,
        actor,
        at,
      })
      .returningAll()
      .executeTakeFirstOrThrow();
    await applyEvent(tx, row);
    seq = row.seq;
  }
  return seq;
}
async function applyEvent(
  tx: Transaction<Tables>,
  row: Selectable<Tables["events"]>,
): Promise<void> {
  const { project, seq } = row;
  switch (row.kind) {
    case "project":
      await tx
        .insertInto("heads")
        .values({ project, rev: seq })
        .onConflict((c) => c.column("project").doUpdateSet({ rev: seq }))
        .execute();
      break;
    case "member": {
      const { person, role } = JSON.parse(decodeUtf8(row.body)) as { person: string; role: string };
      await tx
        .insertInto("members")
        .values({ project, person, role })
        .onConflict((c) => c.columns(["project", "person"]).doUpdateSet({ role }))
        .execute();
      break;
    }
    case "file":
      if (row.path === null) throw new Error("a file event needs a path");
      await tx
        .insertInto("files")
        .values({ project, path: row.path, body: row.body, seq })
        .onConflict((c) => c.columns(["project", "path"]).doUpdateSet({ body: row.body, seq }))
        .execute();
      break;
    case "held": {
      const { person } = JSON.parse(decodeUtf8(row.body)) as { person: string };
      await tx
        .insertInto("held")
        .values({ seq, project, person, at: row.at, body: row.body, state: "open" })
        .execute();
      break;
    }
    case "approved":
    case "declined": {
      const { held } = JSON.parse(decodeUtf8(row.body)) as { held: number };
      const result = await tx
        .updateTable("held")
        .set({ state: row.kind })
        .where("seq", "=", held)
        .where("project", "=", project)
        .where("state", "=", "open")
        .executeTakeFirst();
      if (result.numUpdatedRows !== 1n) throw new Error(`nothing is held under number ${held}`);
      break;
    }
    default:
      throw new Error(`unknown event kind: ${row.kind}`);
  }
  if (row.kind !== "project")
    await tx.updateTable("heads").set({ rev: seq }).where("project", "=", project).execute();
}
export async function rebuild(database: LodgeDatabase): Promise<void> {
  await database.db.transaction().execute(async (tx) => {
    await tx.deleteFrom("held").execute();
    await tx.deleteFrom("heads").execute();
    await tx.deleteFrom("files").execute();
    await tx.deleteFrom("members").execute();
    const events = await tx.selectFrom("events").selectAll().orderBy("seq", "asc").execute();
    for (const event of events) await applyEvent(tx, event);
  });
}

