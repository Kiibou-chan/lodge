  expect(await lodge.held()).toEqual([]);
});
test(\"a_relay_to_a_closed_thread_is_refused\", async () => {
  const { lodge, id, relay } = await setup();
  await lodge.close(id, \"reviewer\");
  await expect(relay()).rejects.toThrow("'`${id} is closed`);
  expect(await lodge.held()).toEqual([]);
});
