  readonly unrecorded: readonly Problem[];
  readonly statuses: ReadonlyMap<string, string>;
}
export function read(value: Omit<Read, "statuses"> & Partial<Read>): Read {
  return { statuses: new Map(), ...value };
}
export interface Shown {
