  publish(
    base: Tree,
    writes: ReadonlyMap<string, string>,
    message: string,
    approves?: number | null,
  ): Promise<PublishOutcome>;
  hold(held: HeldDraft): Promise<number>;
  held(): Promise<readonly Held[]>;
  decline(seq: number, reason: string): Promise<void>;
}
