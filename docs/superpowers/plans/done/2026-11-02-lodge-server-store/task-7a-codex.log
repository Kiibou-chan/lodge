export function isDigit(s: string): boolean {
  return (
    s !== "" &&
    Array.from(s).every((ch) => {
      const cp = ch.codePointAt(0) as number;
      return /\p{Nd}/u.test(ch) || DIGIT_RANGES.some(([lo, hi]) => cp >= lo && cp <= hi);
    })
