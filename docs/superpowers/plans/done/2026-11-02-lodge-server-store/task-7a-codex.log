import { Database } from "bun:sqlite";
import { type Generated, Kysely, SqliteDialect } from "kysely";
import { LodgeError } from "#app";

interface EventsTable {
  seq: Generated<number>;
  project: string;
  at: string;
  actor: string;
  kind: string;
  path: string | null;
  body: Uint8Array;
  message: string | null;
}
interface HeadsTable {
  project: string;
  rev: number;
}
interface FilesTable {
  project: string;
  path: string;
  body: Uint8Array;
  seq: number;
}
interface MembersTable {
  project: string;
  person: string;
  role: string;
}
export interface Tables {
  events: EventsTable;
  heads: HeadsTable;
  files: FilesTable;
  members: MembersTable;
}
export interface LodgeDatabase {
  readonly db: Kysely<Tables>;
  close(): Promise<void>;
}
const MIGRATIONS = [
  `
create table events(seq integer primary key autoincrement, project text not null,
  at text not null, actor text not null, kind text not null, path text, body blob not null, message text);
create trigger events_no_update before update on events begin
  select raise(abort, 'events are append-only'); end;
create trigger events_no_delete before delete on events begin
  select raise(abort, 'events are append-only'); end;
create table heads(project text primary key, rev integer not null);
create table files(project text not null, path text not null, body blob not null,
  seq integer not null, primary key(project, path));
create table members(project text not null, person text not null, role text not null,
  primary key(project, person));
`,
];
export async function openDatabase(path: string): Promise<LodgeDatabase> {
  const raw = new Database(path, { strict: true, create: true });
  try {
    raw.exec("PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000");
    raw
      .transaction(() => {
        const version = (raw.query("PRAGMA user_version").get() as { user_version: number })
          .user_version;
        if (version > MIGRATIONS.length)
          throw new LodgeError(
            `the database at ${path} has schema ${version}, newer than this lodge's ${MIGRATIONS.length}`,
          );
        for (const migration of MIGRATIONS.slice(version)) raw.exec(migration);
        raw.exec(`PRAGMA user_version=${MIGRATIONS.length}`);
      })
      .immediate();
  } catch (error) {
    raw.close();
    throw error;
  }
  const adapted = {
    close: () => raw.close(),
    prepare: (query: string) => {
      const statement = raw.prepare(query);
      return {
        reader: statement.columnNames.length > 0,
        all: (parameters: unknown[]) => statement.all(...(parameters as never[])),
        run: (parameters: unknown[]) => {
          const result = statement.run(...(parameters as never[]));
          return { changes: result.changes, lastInsertRowid: result.lastInsertRowid };
        },
        iterate: (parameters: unknown[]) => statement.iterate(...(parameters as never[])),
      };
    },
  };
  const db = new Kysely<Tables>({ dialect: new SqliteDialect({ database: adapted as never }) });
  return { db, close: () => db.destroy() };
}
import type { Selectable, Transaction } from "kysely";
import { decodeUtf8, encodeUtf8 } from "#core";
import type { LodgeDatabase, Tables } from "./schema.ts";

interface NewEvent {
  readonly kind: string;
  readonly path: string | null;
  readonly body: Uint8Array;
  readonly message: string | null;
}
export function json(value: unknown): Uint8Array {
  return encodeUtf8(JSON.stringify(value));
}
export async function appendEvents(
  tx: Transaction<Tables>,
  project: string,
  actor: string,
  at: string,
  events: readonly NewEvent[],
): Promise<number> {
  let seq = 0;
  for (const event of events) {
    const row = await tx
      .insertInto("events")
      .values({ ...event, project, actor, at })
      .returningAll()
      .executeTakeFirstOrThrow();
    await applyEvent(tx, row);
    seq = row.seq;
  }
  return seq;
}
async function applyEvent(
  tx: Transaction<Tables>,
  row: Selectable<Tables["events"]>,
): Promise<void> {
  const { project, seq } = row;
  switch (row.kind) {
    case "project":
      await tx
        .insertInto("heads")
        .values({ project, rev: seq })
        .onConflict((c) => c.column("project").doUpdateSet({ rev: seq }))
        .execute();
      break;
    case "member": {
      const { person, role } = JSON.parse(decodeUtf8(row.body)) as { person: string; role: string };
      await tx
        .insertInto("members")
        .values({ project, person, role })
        .onConflict((c) => c.columns(["project", "person"]).doUpdateSet({ role }))
        .execute();
      break;
    }
    case "file":
      if (row.path === null) throw new Error("a file event needs a path");
      await tx
        .insertInto("files")
        .values({ project, path: row.path, body: row.body, seq })
        .onConflict((c) => c.columns(["project", "path"]).doUpdateSet({ body: row.body, seq }))
        .execute();
      break;
    default:
      throw new Error(`unknown event kind: ${row.kind}`);
  }
  if (row.kind !== "project")
    await tx.updateTable("heads").set({ rev: seq }).where("project", "=", project).execute();
}
export async function rebuild(database: LodgeDatabase): Promise<void> {
  await database.db.transaction().execute(async (tx) => {
    await tx.deleteFrom("heads").execute();
    await tx.deleteFrom("files").execute();
    await tx.deleteFrom("members").execute();
    const events = await tx.selectFrom("events").selectAll().orderBy("seq", "asc").execute();
    for (const event of events) await applyEvent(tx, event);
  });
}

