import type { Transaction } from "kysely";
import { NotFound, Role } from "#app";
import { ATTACHMENTS, decodeUtf8, type Tree, tree } from "#core";
import type { Tables } from "./schema.ts";
export async function headOf(tx: Transaction<Tables>, project: string): Promise<number> {
  const head = await tx
    .selectFrom("heads")
    .select("rev")
    .where("project", "=", project)
    .executeTakeFirst();
  if (!head) throw new NotFound(`no project named ${project}`);
  return head.rev;
}
export async function touchHead(
  tx: Transaction<Tables>,
  project: string,
  rev?: number,
): Promise<boolean> {
  let query = tx
    .updateTable("heads")
    .set((eb) => ({ rev: eb.ref("rev") }))
    .where("project", "=", project);
  if (rev !== undefined) query = query.where("rev", "=", rev);
  const result = await query.executeTakeFirst();
  return result.numUpdatedRows !== 0n;
}
export async function readTree(tx: Transaction<Tables>, project: string): Promise<Tree> {
  const rev = await headOf(tx, project);
  const rows = await tx
    .selectFrom("files")
    .selectAll()
    .where("project", "=", project)
    .orderBy("path", "asc")
    .execute();
  const files = new Map<string, string>(),
    attachments = new Set<string>();
  for (const row of rows) {
    if (row.path.startsWith(ATTACHMENTS)) attachments.add(row.path);
    else files.set(row.path, decodeUtf8(row.body));
  }
  const owners = await tx
    .selectFrom("members")
    .select("person")
    .where("project", "=", project)
    .where("role", "=", Role.OWNER)
    .execute();
  return tree({
    rev: String(rev),
    files,
    attachments,
    people: new Set(owners.map((row) => row.person)),
  });
}

export async function openHold(tx: Transaction<Tables>, project: string, seq: number) {
  return tx
    .selectFrom("held")
    .select("seq")
    .where("seq", "=", seq)
    .where("project", "=", project)
    .where("state", "=", "open")
    .executeTakeFirst();
}
import {
  type Clock,
  CommitOutcome,
  committed,
  gate,
  type Held,
  type HeldDraft,
  LodgeError,
  NotFound,
  PublishOutcome,
  type Store,
  stampOf,
} from "#app";
import { ATTACHMENTS, decodeUtf8, encodeUtf8, type Tree, ValueError } from "#core";
import { appendEvents, json } from "./events.ts";
import { openHold, readTree, touchHead } from "./read-tree.ts";
import type { LodgeDatabase } from "./schema.ts";
export class SqliteStore implements Store {
  constructor(
    private readonly database: LodgeDatabase,
    private readonly project: string,
    private readonly actor: string,
    private readonly clock: Clock,
  ) {}
  async hold(held: HeldDraft): Promise<number> {
    return this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, this.project)))
        throw new NotFound(`no project named ${this.project}`);
      return appendEvents(tx, this.project, this.actor, stampOf(this.clock.now()), [
        { kind: "held", path: null, body: json(held), message: null },
      ]);
    });
  }
  async held(): Promise<readonly Held[]> {
    const rows = await this.database.db
      .selectFrom("held")
      .selectAll()
      .where("project", "=", this.project)
      .where("state", "=", "open")
      .orderBy("seq", "asc")
      .execute();
    return rows.map((row) => ({
      ...(JSON.parse(decodeUtf8(row.body)) as HeldDraft),
      seq: row.seq,
      at: row.at,
    }));
  }
  async decline(seq: number, reason: string): Promise<void> {
    await this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, this.project)))
        throw new NotFound(`no project named ${this.project}`);
      const held = await openHold(tx, this.project, seq);
      if (!held) throw new NotFound(`nothing is held under number ${seq}`);
      await appendEvents(tx, this.project, this.actor, stampOf(this.clock.now()), [
        { kind: "declined", path: null, body: json({ held: seq, reason }), message: null },
      ]);
    });
  }
  async trees(): Promise<readonly [Tree, Tree]> {
    return this.database.db.transaction().execute(async (tx) => {
      const current = await readTree(tx, this.project);
      return [current, current] as const;
    });
  }
  async attachmentTexts(): Promise<ReadonlyMap<string, string>> {
    const rows = await this.database.db
      .selectFrom("files")
      .selectAll()
      .where("project", "=", this.project)
      .where("path", ">=", ATTACHMENTS)
      .where("path", "<", "lodge/attachments0")
      .execute();
    return new Map(rows.map((row) => [row.path, decodeUtf8(row.body)]));
  }
  async freshness() {
    return null;
  }
  async gate(current: Tree) {
    return gate({ published: current, checked: [["", current]] });
  }
  async commit(_paths: readonly string[], _message: string) {
    return committed({
      outcome: CommitOutcome.FAILED,
      detail: "the server keeps no checkout; its writes are published at once",
    });
  }
  async publish(
    base: Tree,
    writes: ReadonlyMap<string, string>,
    message: string,
    approves: number | null = null,
  ): Promise<PublishOutcome> {
    const events: { kind: string; path: string; body: Uint8Array; message: string }[] = [];
    for (const path of writes.keys()) {
      const parts = path.split("/");
      if (
        parts[0] !== "lodge" ||
        parts.length < 2 ||
        path.includes("\\") ||
        path.includes("\0") ||
        parts.some((part) => ["", ".", "..", ".git"].includes(part))
      )
        throw new LodgeError(`${path} is outside lodge/, which is all the store writes`);
      if (base.attachments.has(path))
        throw new LodgeError(`${path} is an attachment, and lodge never overwrites an attachment`);
    }
    for (const path of writes.keys()) {
      if (/\p{Cs}/u.test(path))
        throw new LodgeError(`${path}: a path holding a lone surrogate cannot be stored`);
    }
    for (const [path, text] of writes) {
      if (
        path.startsWith("lodge/decisions/") &&
        base.files.has(path) &&
        base.files.get(path) !== text
      )
        throw new LodgeError(
          `${path} is a published decision, and lodge never rewrites a decision`,
        );
    }
    for (const [path, text] of writes) {
      try {
        events.push({ kind: "file", path, body: encodeUtf8(text), message });
      } catch (error) {
        if (!(error instanceof ValueError)) throw error;
        throw new LodgeError(`${path}: ${error.message}`);
      }
    }
    if (base.rev === null || !/^[0-9]+$/u.test(base.rev)) return PublishOutcome.REJECTED;
    return this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, this.project, Number(base.rev)))) return PublishOutcome.REJECTED;
      if (approves !== null) {
        const held = await openHold(tx, this.project, approves);
        if (!held) return PublishOutcome.REJECTED;
      }
      const at = stampOf(this.clock.now());
      await appendEvents(tx, this.project, this.actor, at, events);
      if (approves !== null)
        await appendEvents(tx, this.project, this.actor, at, [
          { kind: "approved", path: null, body: json({ held: approves }), message: null },
        ]);
      return PublishOutcome.PUBLISHED;
    });
  }
}
import {
  type Actor,
  actorText,
  type Clock,
  Conflict,
  LodgeError,
  NotFound,
  type Projects,
  type Role,
  stampOf,
} from "#app";
import { byCodePoint, load } from "#core";
import { appendEvents, json } from "./events.ts";
import { headOf, readTree, touchHead } from "./read-tree.ts";
import type { LodgeDatabase } from "./schema.ts";
import { SqliteStore } from "./sqlite-store.ts";

const PROJECT_NAME = { pattern: /^[a-z0-9][a-z0-9-]{0,62}$/u, what: "a project name" };
const PERSON_NAME = { pattern: /^[a-z][a-z0-9-]{0,31}$/u, what: "a person's name" };
function checkName(name: string, rule: { pattern: RegExp; what: string }): void {
  if (!rule.pattern.test(name))
    throw new LodgeError(`${name} is not ${rule.what}: ${rule.pattern.source}`);
}
export class SqliteProjects implements Projects {
  constructor(
    private readonly database: LodgeDatabase,
    private readonly clock: Clock,
  ) {}
  async create(project: string, owner: string): Promise<void> {
    checkName(project, PROJECT_NAME);
    checkName(owner, PERSON_NAME);
    await this.database.db.transaction().execute(async (tx) => {
      const result = await tx
        .insertInto("heads")
        .values({ project, rev: 0 })
        .onConflict((c) => c.column("project").doNothing())
        .executeTakeFirst();
      if (result.numInsertedOrUpdatedRows === 0n)
        throw new Conflict(`a project named ${project} exists`);
      await appendEvents(tx, project, owner, stampOf(this.clock.now()), [
        { kind: "project", path: null, body: json({ owner }), message: null },
        { kind: "member", path: null, body: json({ person: owner, role: "owner" }), message: null },
      ]);
    });
  }
  async members(project: string): Promise<ReadonlyMap<string, Role>> {
    return this.database.db.transaction().execute(async (tx) => {
      await headOf(tx, project);
      const rows = await tx
        .selectFrom("members")
        .selectAll()
        .where("project", "=", project)
        .execute();
      return new Map(
        rows
          .sort((a, b) => byCodePoint(a.person, b.person))
          .map((row) => [row.person, row.role as Role]),
      );
    });
  }
  async addMember(project: string, person: string, role: Role, by: Actor): Promise<void> {
    checkName(person, PERSON_NAME);
    await this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, project))) throw new NotFound(`no project named ${project}`);
      const member = await tx
        .selectFrom("members")
        .select("person")
        .where("project", "=", project)
        .where("person", "=", person)
        .executeTakeFirst();
      if (member) throw new Conflict(`${person} is a member of ${project}`);
      const snapshot = load(await readTree(tx, project));
      const ids = [...snapshot.decisions.values()]
        .filter((d) => d.decidedBy === person)
        .map((d) => d.id);
      ids.push(
        ...[...snapshot.threads.values()]
          .filter((t) => t.messages.some((m) => m.by === person))
          .map((t) => t.id),
      );
      ids.sort(byCodePoint);
      if (ids.length)
        throw new Conflict(`${person} is a role in ${ids[0]}, so it cannot name a person`);
      await appendEvents(tx, project, actorText(by), stampOf(this.clock.now()), [
        { kind: "member", path: null, body: json({ person, role }), message: null },
      ]);
    });
  }
  storeFor(project: string, actor: Actor): SqliteStore {
    return new SqliteStore(this.database, project, actorText(actor), this.clock);
  }
}
import { expect } from "bun:test";
import { Lodge, person, type Store } from "#app";
