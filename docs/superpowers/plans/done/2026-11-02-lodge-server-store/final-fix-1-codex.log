    .where("seq", "=", seq)
    .where("project", "=", project)
    .where("state", "=", "open")
    .executeTakeFirst();
}
import {
  type Actor,
  actorText,
  type Clock,
  Conflict,
  LodgeError,
  NotFound,
  type Projects,
  type Role,
  stampOf,
} from "#app";
import { byCodePoint, load } from "#core";
import { appendEvents, json } from "./events.ts";
import { headOf, readTree, touchHead } from "./read-tree.ts";
import type { LodgeDatabase } from "./schema.ts";
import { SqliteStore } from "./sqlite-store.ts";

const PROJECT_NAME = { pattern: /^[a-z0-9][a-z0-9-]{0,62}$/u, what: "a project name" };
const PERSON_NAME = { pattern: /^[a-z][a-z0-9-]{0,31}$/u, what: "a person's name" };
function checkName(name: string, rule: { pattern: RegExp; what: string }): void {
  if (!rule.pattern.test(name))
    throw new LodgeError(`${name} is not ${rule.what}: ${rule.pattern.source}`);
}
export class SqliteProjects implements Projects {
  constructor(
    private readonly database: LodgeDatabase,
    private readonly clock: Clock,
  ) {}
  async create(project: string, owner: string): Promise<void> {
    checkName(project, PROJECT_NAME);
    checkName(owner, PERSON_NAME);
    await this.database.db.transaction().execute(async (tx) => {
      const result = await tx
        .insertInto("heads")
        .values({ project, rev: 0 })
        .onConflict((c) => c.column("project").doNothing())
        .executeTakeFirst();
      if (result.numInsertedOrUpdatedRows === 0n)
        throw new Conflict(`a project named ${project} exists`);
      await appendEvents(tx, project, owner, stampOf(this.clock.now()), [
        { kind: "project", path: null, body: json({ owner }), message: null },
        { kind: "member", path: null, body: json({ person: owner, role: "owner" }), message: null },
      ]);
    });
  }
  async members(project: string): Promise<ReadonlyMap<string, Role>> {
    return this.database.db.transaction().execute(async (tx) => {
      await headOf(tx, project);
      const rows = await tx
        .selectFrom("members")
        .selectAll()
        .where("project", "=", project)
        .execute();
      return new Map(
        rows
          .sort((a, b) => byCodePoint(a.person, b.person))
          .map((row) => [row.person, row.role as Role]),
      );
    });
  }
  async addMember(project: string, person: string, role: Role, by: Actor): Promise<void> {
    checkName(person, PERSON_NAME);
    await this.database.db.transaction().execute(async (tx) => {
      if (!(await touchHead(tx, project))) throw new NotFound(`no project named ${project}`);
      const member = await tx
        .selectFrom("members")
        .select("person")
        .where("project", "=", project)
        .where("person", "=", person)
        .executeTakeFirst();
      if (member) throw new Conflict(`${person} is a member of ${project}`);
      const snapshot = load(await readTree(tx, project));
      const ids = [...snapshot.decisions.values()]
        .filter((d) => d.decidedBy === person)
        .map((d) => d.id);
      ids.push(
        ...[...snapshot.threads.values()]
          .filter((t) => t.messages.some((m) => m.by === person))
          .map((t) => t.id),
      );
      ids.sort(byCodePoint);
      if (ids.length)
        throw new Conflict(`${person} is a role in ${ids[0]}, so it cannot name a person`);
      await appendEvents(tx, project, actorText(by), stampOf(this.clock.now()), [
        { kind: "member", path: null, body: json({ person, role }), message: null },
      ]);
    });
  }
  storeFor(project: string, actor: Actor): SqliteStore {
    return new SqliteStore(this.database, project, actorText(actor), this.clock);
  }
}
import { expect, test } from "bun:test";
import { AddOutcome, CommitOutcome, PublishOutcome } from "#app";
import { decodeUtf8, load, tree } from "#core";
import { AREA, wired } from "../app/support.ts";
import { decisionText, specText } from "../core/applying.ts";
import { filesOf } from "../core/builders.ts";
import { events, setup } from "./support.ts";

test("trees_give_one_state", async () => {
  const { store } = await setup();
  const [a, b] = await store.trees();
  expect(a).toBe(b);
  expect(a.rev).toBe("2");
  expect(a.files.size).toBe(0);
});
test("a_write_is_one_event_per_file", async () => {
  const { store, database } = await setup();
  expect(
    await store.publish(
      (await store.trees())[0],
      new Map([
        ["lodge/a", "a"],
        ["lodge/b", "b"],
      ]),
      "write",
    ),
  ).toBe(PublishOutcome.PUBLISHED);
  expect(
    (await events(database)).slice(2).map(({ kind, path, message, actor, at }) => ({
      kind,
      path,
      message: message === null ? null : decodeUtf8(message),
      actor,
      at,
    })),
  ).toEqual(
    ["lodge/a", "lodge/b"].map((path) => ({
      kind: "file",
      path,
      message: "write",
      actor: "author",
      at: "2026-10-29T09:30:00+01:00",
    })),
  );
});
test("file_bytes_survive_exactly", async () => {
  const { store, database } = await setup();
  const text = "\uFEFFa\r\n\0😀\uDC80";
  await store.publish((await store.trees())[0], new Map([["lodge/a", text]]), "");
  expect((await store.trees())[0].files.get("lodge/a")).toBe(text);
  expect((await events(database))[2]?.body.at(-1)).toBe(128);
});
test("stale_base_is_rejected_and_writes_nothing", async () => {
  const { store, database } = await setup();
  const base = (await store.trees())[0];
  await store.publish(base, new Map([["lodge/a", "a"]]), "");
  const before = await events(database);
  for (const rev of [base.rev, null, "x", "2.0", "-1"])
    expect(await store.publish(tree({ ...base, rev }), new Map([["lodge/b", "b"]]), "")).toBe(
      PublishOutcome.REJECTED,
    );
  expect(await events(database)).toEqual(before);
});
test("attachments_are_listed_not_read", async () => {
  const { store } = await setup();
  const path = "lodge/attachments/d-aaaaaa/run.log";
  await store.publish((await store.trees())[0], new Map([[path, "\uFEFF\uDC80"]]), "");
  const current = (await store.trees())[0];
  expect(current.attachments.has(path)).toBe(true);
  expect(current.files.has(path)).toBe(false);
  expect(await store.attachmentTexts()).toEqual(new Map([[path, "\uFEFF\uDC80"]]));
});
test("gate_compares_the_current_state_with_itself", async () => {
  const { store } = await setup();
  const current = (await store.trees())[0];
  const result = await store.gate(current);
  expect(result.published).toBe(current);
  expect(result.checked).toEqual([["", current]]);
  expect(result.notes).toEqual([]);
});
test("freshness_is_null_and_commit_is_refused", async () => {
  const { store, database, clock } = await setup();
  const before = await events(database);
  const calls = clock.calls;
  expect(await store.freshness()).toBeNull();
  expect(await store.commit([], "")).toEqual({
    outcome: CommitOutcome.FAILED,
    detail: "the server keeps no checkout; its writes are published at once",
  });
  expect(await events(database)).toEqual(before);
  expect(clock.calls).toBe(calls);
});
test("lodge_adds_through_the_store", async () => {
  const { store } = await setup();
  await store.publish((await store.trees())[0], filesOf(AREA), "area");
  const result = await wired(store).add(
    [
      [
        "d.md",
        decisionText("changes:", "  - {entry: s-bbbbbb, action: create}", "attachments: [run.log]"),
      ],
      ["s.md", specText("id: s-bbbbbb", "area: storage")],
    ],
    { attachments: [["run.log", "log"]] },
  );
  expect(result.outcome).toBe(AddOutcome.PUBLISHED);
  const current = (await store.trees())[0];
  expect(load(current).entries.has("s-bbbbbb")).toBe(true);
  expect(current.attachments.has("lodge/attachments/d-111111/run.log")).toBe(true);
});

test.each(["t\uDC80 tail", "\uFEFFlead"])(
  "event_message_bytes_survive_exactly",
  async (message) => {
    const { store, database } = await setup();
    await store.publish((await store.trees())[0], new Map([["lodge/a", "a"]]), message);
    const saved = (await events(database))[2]?.message;
    expect(saved).toBeInstanceOf(Uint8Array);
    expect(decodeUtf8(saved as Uint8Array)).toBe(message);
  },
);
import { expect, test } from "bun:test";
import { PublishOutcome } from "#app";
import { writeRecord } from "#core";
import { decision } from "../core/builders.ts";
import { events, setup } from "./support.ts";

test.each(
  [
    "notes/x",
    "lodge",
    "lodge/../x",
    "lodge//x",
    "lodge/./x",
    "lodge/.git/x",
    "lodge\\x",
    "lodge/x\0",
  ].map((c) => [c]),
)("path_outside_lodge_is_refused", async (path) => {
  const { store, database } = await setup();
  const before = await events(database);
  await expect(store.publish((await store.trees())[0], new Map([[path, "x"]]), "")).rejects.toThrow(
    `${path} is outside lodge/, which is all the store writes`,
  );
  expect(await events(database)).toEqual(before);
});
test("lone_surrogate_outside_the_escapes_is_refused", async () => {
  const { store, database } = await setup();
  const before = await events(database);
  await expect(
    store.publish(
      (await store.trees())[0],
      new Map([
        ["lodge/good", "ok"],
        ["lodge/a", "\uD800"],
      ]),
      "",
    ),
  ).rejects.toThrow("lodge/a: cannot encode lone surrogate '\\ud800'");
  expect(await events(database)).toEqual(before);
});
test.each(["\uDC80", "\uD800"].map((c) => [c]))(
  "a_path_holding_a_surrogate_is_refused",
  async (ch) => {
    const { store, database } = await setup();
    const before = await events(database);
    const path = `lodge/${ch}`;
    await expect(
      store.publish((await store.trees())[0], new Map([[path, "x"]]), ""),
    ).rejects.toThrow(`${path}: a path holding a lone surrogate cannot be stored`);
    expect(await events(database)).toEqual(before);
    expect(await store.publish((await store.trees())[0], new Map([["lodge/😀", "x"]]), "")).toBe(
      PublishOutcome.PUBLISHED,
    );
  },
);
test("an_attachment_is_never_overwritten", async () => {
  const { store, database } = await setup();
  const path = "lodge/attachments/d-aaaaaa/run.log";
  await store.publish((await store.trees())[0], new Map([[path, "first"]]), "");
  const before = await events(database);
  await expect(
    store.publish((await store.trees())[0], new Map([[path, "second"]]), ""),
  ).rejects.toThrow(`${path} is an attachment, and lodge never overwrites an attachment`);
  expect(await events(database)).toEqual(before);
  expect((await store.attachmentTexts()).get(path)).toBe("first");
});
test("a_published_decision_is_never_rewritten", async () => {
  const { store, database } = await setup();
  const path = "lodge/decisions/d-aaaaaa.md";
  const text = writeRecord(decision({ id: "d-aaaaaa" }));
  await store.publish((await store.trees())[0], new Map([[path, text]]), "");
  const before = await events(database);
  await expect(
    store.publish((await store.trees())[0], new Map([[path, `${text}\n`]]), ""),
  ).rejects.toThrow(`${path} is a published decision, and lodge never rewrites a decision`);
  expect(await events(database)).toEqual(before);
  expect(await store.publish((await store.trees())[0], new Map([[path, text]]), "")).toBe(
    PublishOutcome.PUBLISHED,
  );
});

test("refusals_follow_phases_across_all_paths", async () => {
  const { store, database } = await setup();
  const path = "lodge/decisions/d-aaaaaa.md";
  await store.publish((await store.trees())[0], new Map([[path, "first"]]), "");
  const base = (await store.trees())[0];
  const before = await events(database);
  await expect(
    store.publish(
      base,
      new Map([
        [path, "changed"],
        ["notes/x", "x"],
      ]),
      "",
    ),
  ).rejects.toThrow("notes/x is outside lodge/, which is all the store writes");
  await expect(
    store.publish(
      base,
      new Map([
        [path, "changed"],
        ["lodge/\uD800", "x"],
      ]),
      "",
    ),
  ).rejects.toThrow("a path holding a lone surrogate cannot be stored");
  await expect(
    store.publish(
      base,
      new Map([
        ["lodge/a", "\uD800"],
        [path, "changed"],
      ]),
      "",
    ),
  ).rejects.toThrow(`${path} is a published decision, and lodge never rewrites a decision`);
  expect(await events(database)).toEqual(before);
});
import { expect, test } from "bun:test";
import { mkdtempSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { Conflict, LodgeError, NotFound, person, Role } from "#app";
import { openDatabase, SqliteProjects, SqliteStore } from "#store";
import { FixedClock } from "../app/fakes.ts";
import { decision, filesOf, message, thread } from "../core/builders.ts";
import { events, setup } from "./support.ts";

test("create_writes_the_project_and_its_owner", async () => {
  const { database, projects } = await setup();
  expect(
    (await events(database)).map((e) => [
      e.kind,
      e.actor,
      JSON.parse(new TextDecoder().decode(e.body)),
    ]),
  ).toEqual([
    ["project", "author", { owner: "author" }],
    ["member", "author", { person: "author", role: "owner" }],
  ]);
  expect(await projects.members("storage")).toEqual(new Map([["author", Role.OWNER]]));
  expect(projects.storeFor("storage", person("author"))).toBeInstanceOf(SqliteStore);
});
test("existing_project_conflicts", async () => {
  const { projects } = await setup();
  await expect(projects.create("storage", "bo")).rejects.toThrow(
    new Conflict("a project named storage exists"),
  );
});
test.each([
  ["Lodge", "author"],
  ["-x", "author"],
  ["x".repeat(64), "author"],
  ["other", "Ada"],
  ["other", "1ada"],
])("names_are_checked", async (project, owner) => {
  const { projects, database } = await setup();
  const before = await events(database);
  const expected =
    owner === "author"
      ? `${project} is not a project name: ^[a-z0-9][a-z0-9-]{0,62}$`
      : `${owner} is not a person's name: ^[a-z][a-z0-9-]{0,31}$`;
  await expect(projects.create(project, owner)).rejects.toThrow(new LodgeError(expected));
  expect(await events(database)).toEqual(before);
});
test("add_member_needs_a_new_name", async () => {
  const { projects, database } = await setup();
  await projects.addMember("storage", "bo", Role.MEMBER, person("author"));
  expect([...(await projects.members("storage"))]).toEqual([
    ["author", Role.OWNER],
    ["bo", Role.MEMBER],
  ]);
  expect((await events(database)).at(-1)?.actor).toBe("author");
  await expect(projects.addMember("storage", "bo", Role.OWNER, person("author"))).rejects.toThrow(
    "bo is a member of storage",
  );
  await expect(projects.addMember("storage", "Ada", Role.MEMBER, person("author"))).rejects.toThrow(
    LodgeError,
  );
});
test("unknown_project_is_not_found", async () => {
  const { projects, database, clock } = await setup();
  await expect(projects.members("unknown")).rejects.toThrow(
    new NotFound("no project named unknown"),
  );
  await expect(projects.addMember("unknown", "bo", Role.MEMBER, person("author"))).rejects.toThrow(
    NotFound,
  );
  await expect(new SqliteStore(database, "unknown", "author", clock).trees()).rejects.toThrow(
    NotFound,
  );
});
test("a_second_create_conflicts_across_connections", async () => {
  const folder = mkdtempSync(join(tmpdir(), "lodge-store-"));
  const a = await openDatabase(join(folder, "store.db"));
  const b = await openDatabase(join(folder, "store.db"));
  try {
    const clock = new FixedClock();
    await new SqliteProjects(a, clock).create("storage", "author");
    await expect(new SqliteProjects(b, clock).create("storage", "bo")).rejects.toThrow(Conflict);
  } finally {
    await a.close();
    await b.close();
    rmSync(folder, { recursive: true });
  }
});
test("a_name_used_as_a_role_cannot_join", async () => {
  const { store, projects, database } = await setup();
  await store.publish(
    (await store.trees())[0],
    filesOf(
