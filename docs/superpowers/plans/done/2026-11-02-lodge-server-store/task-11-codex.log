    current,
    new Map([...files, ...placed]),
    message(after, applied.ids),
  );
  if (outcome === PublishOutcome.REJECTED) return null;
  return added({
    ids: applied.ids,
    feedback: notes,
    check,
    outcome: outcome === PublishOutcome.PUBLISHED ? AddOutcome.PUBLISHED : AddOutcome.STAGED,
    paths: [...files.keys(), ...placed.keys()],
