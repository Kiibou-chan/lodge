    level3: provenance ? level3(s, d, id) : null,
    read: state.read,
    changing: reasoning ? level2Views(s, d, id, state.failing) : [],
    threads: newestLast([...s.threads.values()].filter((t) => t.about === id)),
    confirmable: confirmableIds(s, d).has(id),
    restsOn: restsOnTree(s, d, id),
    supports: views(state, d.supports.get(id) ?? []),
  };
}
export async function waitingAll(w: Wiring): Promise<readonly [Listed, ThreadsWaiting]> {
  const state = await readChecked(w);
  return [
    listed({ items: newestFirst(state, state.derived.awaitingAuthor), read: state.read }),
    waitingIn(state),
  ] as const;
}
export async function timeline(w: Wiring, limit: number): Promise<Listed> {
  if (limit < 0) throw new LodgeError(`the limit must not be negative, got ${limit}`);
  const state = await readChecked(w),
    all = newestFirst(state, state.snapshot.decisions.keys());
  return listed({
    items: all.slice(0, limit),
    read: state.read,
    more: Math.max(0, all.length - limit),
  });
}
export async function spec(
  w: Wiring,
  area: string | null,
): Promise<readonly [string, Read, readonly SpecArea[]]> {
  const state = await readChecked(w),
    s = state.snapshot;
  if (area !== null && !s.areas.has(area) && [...s.entries.values()].every((e) => e.area !== area))
    throw notFound(state, `area named ${area}`, area);
  return [
    renderSpec(s, state.derived, state.failing, area),
    state.read,
    specView(s, state.derived, state.failing, area),
  ];
}
export async function check(w: Wiring, gate: boolean): Promise<readonly [CheckResult, Read]> {
  const state = await readChecked(w);
  if (!gate) return [state.result, state.read] as const;
  const base = await w.store.gate(state.current),
    published = load(base.published),
    now = stampOf(w.clock.now());
  const found = new Map<string, { problem: Problem; labels: string[] }>(),
    notes = new Set<string>();
  for (const [label, tree] of base.checked) {
    const snapshot = tree === state.current ? state.snapshot : load(tree);
    const result = checkChange(published, snapshot, w.settings, now);
    for (const p of result.problems) {
      const key = JSON.stringify([p.path, p.check, p.line, p.message]);
      const item = found.get(key);
      if (item) item.labels.push(label);
      else found.set(key, { problem: p, labels: [label] });
    }
    for (const note of result.notes) notes.add(note);
  }
  for (const note of base.notes) notes.add(note);
  const problems = [...found.values()]
    .sort(
      (a, b) =>
        byCodePoint(a.problem.path, b.problem.path) ||
        a.problem.check - b.problem.check ||
        byCodePoint(a.problem.message, b.problem.message),
    )
    .map(({ problem, labels }) => {
      const named = labels.filter(Boolean).join(" and ");
      return named ? { ...problem, message: `${named}: ${problem.message}` } : problem;
    });
  return [checkResult(problems, [...notes]), state.read] as const;
}
export async function draft(w: Wiring, ref: string): Promise<string> {
  const state = await readState(w.store),
    s = state.snapshot;
  let path: string,
    extra = "";
  if (ref.startsWith("area:")) {
    const name = ref.slice(5);
    if (!s.areas.has(name)) throw notFound(state, `area named ${name}`, name);
    path = areaPath(name);
    extra = `name: ${name}\n`;
  } else {
    const id = resolveRef(state, ref),
      found = s.paths.get(id);
    if (found === undefined) throw new Error(`missing path for ${id}`);
    path = found;
  }
  const raw = state.current.files.get(path);
  if (raw === undefined) throw new Error(`missing file ${path}`);
  const text = raw.replaceAll("\r\n", "\n");
  return text.replace("---\n", `---\n${extra}base: ${contentHash(text)}\n`);
}
function newestFirst(state: State, ids: Iterable<string>) {
  const decisions = state.snapshot.decisions;
  function date(id: string): number {
    const decision = decisions.get(id);
    if (decision === undefined) throw new Error(`missing decision ${id}`);
    return instant(decision.date);
  }
  return views(
    state,
    [...ids].sort((a, b) => date(b) - date(a) || byCodePoint(b, a)),
  );
}
function views(state: State, ids: Iterable<string>) {
  return [...ids].map((id) => level1(state.snapshot, state.derived, id, state.failing));
}
import {
  cleanText,
  confirmableIds,
  confirmationDraft,
  behindArea as coreBehindArea,
  level1,
  Scope,
  ValueError,
  VIEWER,
} from "#core";
import { Forbidden, LodgeError, StaleList } from "./errors.ts";
import { AddOutcome, type Behind, type Written, written } from "./results.ts";
import { notFound, readState, type State, type Wiring } from "./state.ts";
import { minuteOf } from "./time.ts";
import { add } from "./writes.ts";

function behindIds(state: State, name: string): readonly string[] {
  const s = state.snapshot;
  if (!s.areas.has(name) && [...s.entries.values()].every((e) => e.area !== name))
    throw notFound(state, `area named ${name}`, name);
  return coreBehindArea(s, state.derived, name);
}
export async function behindArea(w: Wiring, name: string): Promise<readonly Behind[]> {
  const state = await readState(w.store);
  const s = state.snapshot;
  return behindIds(state, name).map((id) => {
    const decision = s.decisions.get(id);
    if (decision === undefined) throw new Error(`missing decision ${id}`);
    return {
      decision: level1(s, state.derived, id, state.failing),
      entries: [...new Set(decision.changes.map((c) => c.entry))].flatMap((id) => {
        const e = s.entries.get(id);
        return e ? [[id, e.area] as const] : [];
      }),
    };
  });
}
function expectedIds(state: State, ids: readonly string[], area: string | null): readonly string[] {
  if (area !== null) return behindIds(state, area);
  if (ids.length === 1 && confirmableIds(state.snapshot, state.derived).has(ids[0] ?? ""))
    return ids;
  return [];
}
// Callers serialise confirmations across this entire operation, including retries and commit.
export async function confirmDecisions(
  w: Wiring,
  ids: readonly string[],
  words: string,
  area: string | null,
  commit: boolean,
): Promise<Written> {
  words = cleanText(words);
  if (words.includes("\r\n"))
    throw new LodgeError("your words hold a character lodge cannot store");
  if (!words) throw new LodgeError("your words are required; nothing was written");
  if (w.actor.kind !== "person") throw new Forbidden("only a person confirms; nothing was written");
  const state = await readState(w.store);
  if (!state.snapshot.people.has(w.actor.name))
    throw new Forbidden("only an owner of the project confirms; nothing was written");
  const expected = expectedIds(state, ids, area);
  const given = new Set(ids);
  if (!expected.length || ids.length !== expected.length || expected.some((id) => !given.has(id)))
    throw new StaleList("the list changed since the page was loaded; nothing was written");
  const scope = expected.some((id) => state.snapshot.decisions.get(id)?.scope === Scope.PRODUCT)
    ? Scope.PRODUCT
    : Scope.PROCESS;
  let draft: string;
  try {
    draft = confirmationDraft(expected, scope, words, minuteOf(w.clock.now()), area, w.actor.name);
  } catch (error) {
    if (!(error instanceof ValueError)) throw error;
    throw new LodgeError("your words hold a character lodge cannot store", { cause: error });
  }
  const added = await add(w, [[VIEWER, draft]]);
  const committed =
    added.outcome === AddOutcome.STAGED && commit
      ? await w.store.commit(added.paths, `Author confirmation from the viewer: ${added.ids[0]}`)
      : null;
  return written({ ids: added.ids, outcome: added.outcome, check: added.check, committed });
}
import type { CheckResult, CoreSettings, Filters, Raises, SpecArea } from "#core";
import * as confirmations from "./confirm.ts";
import * as holds from "./held.ts";
import type { Actor, Clock, Held, IdSource, Store } from "./ports.ts";
import * as reads from "./reads.ts";
import type {
  Added,
  Approved,
  Behind,
  Listed,
  Read,
  Shown,
  ThreadList,
  ThreadShown,
  ThreadsWaiting,
  Written,
} from "./results.ts";
import type { Wiring } from "./state.ts";
import * as threads from "./threads.ts";
import { type AddOptions, add, mint } from "./writes.ts";

export class Lodge {
  private readonly wiring: Wiring;
  constructor(store: Store, clock: Clock, ids: IdSource, settings: CoreSettings, actor: Actor) {
    this.wiring = { store, clock, ids, settings, actor };
  }
  async held(): Promise<readonly Held[]> {
    return holds.held(this.wiring);
  }
  async approve(seq: number): Promise<Approved> {
    return holds.approve(this.wiring, seq);
  }
  async decline(seq: number, reason: string): Promise<void> {
    return holds.decline(this.wiring, seq, reason);
  }
  async mint(prefix: "d" | "s"): Promise<string> {
    return mint(this.wiring, prefix);
  }
  async add(
    drafts: readonly (readonly [string, string])[],
    options: AddOptions = {},
  ): Promise<Added> {
    return add(this.wiring, drafts, options);
  }
  async search(query: string, filters: Filters, { limit = 20 } = {}): Promise<Listed> {
    return reads.searchRecords(this.wiring, query, filters, limit);
  }
  async show(ref: string, { reasoning = false, provenance = false } = {}): Promise<Shown> {
    return reads.show(this.wiring, ref, reasoning, provenance);
  }
  async waitingAll(): Promise<readonly [Listed, ThreadsWaiting]> {
    return reads.waitingAll(this.wiring);
  }
  async timeline({ limit = 50 } = {}): Promise<Listed> {
    return reads.timeline(this.wiring, limit);
  }
  async spec({
    area = null,
  }: {
    area?: string | null;
  } = {}): Promise<readonly [string, Read, readonly SpecArea[]]> {
    return reads.spec(this.wiring, area);
  }
  async problems(): Promise<readonly [CheckResult, Read]> {
    return this.check(false);
  }
  async check(gate: boolean): Promise<readonly [CheckResult, Read]> {
    return reads.check(this.wiring, gate);
  }
  async draft(ref: string): Promise<string> {
    return reads.draft(this.wiring, ref);
  }
  async ask(
    ref: string,
    raises: Raises,
    by: string,
    text: string,
    options: threads.MessageOptions = {},
  ): Promise<Written> {
    return threads.writeMessage(this.wiring, ref, raises, by, text, options);
  }
  async reply(
    thread: string,
    by: string,
    text: string,
    options: threads.MessageOptions = {},
  ): Promise<Written> {
    return threads.writeMessage(this.wiring, thread, null, by, text, options);
  }
  async close(
    thread: string,
    by: string,
    { text = null, ...options }: threads.MessageOptions & { text?: string | null } = {},
  ): Promise<Written> {
    return threads.writeMessage(this.wiring, thread, null, by, text ?? "", {
      ...options,
      close: true,
    });
  }
  async threads(): Promise<ThreadList> {
    return threads.listOpen(this.wiring);
  }
  async thread(ref: string): Promise<ThreadShown> {
    return threads.show(this.wiring, ref);
  }
  async threadsWaiting(): Promise<ThreadsWaiting> {
    return threads.waiting(this.wiring);
  }
  async confirm(
    ids: readonly string[],
    words: string,
    { area = null, commit = false }: { area?: string | null; commit?: boolean } = {},
  ): Promise<Written> {
    return confirmations.confirmDecisions(this.wiring, ids, words, area, commit);
  }
  async behindArea(name: string): Promise<readonly Behind[]> {
    return confirmations.behindArea(this.wiring, name);
  }
}

