export function reviewFlags(
  s: Snapshot,
  oldest: readonly Decision[],
  touches: ReadonlyMap<string, readonly string[]>,
  changes: ReadonlyMap<string, readonly Decision[]>,
): ReadonlyMap<string, readonly string[]> {
