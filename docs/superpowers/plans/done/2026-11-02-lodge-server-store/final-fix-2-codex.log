  promise: Promise<unknown>,
  errorClass: new (message: string) => Error,
  pattern: string | RegExp,
): Promise<void> {
  await expect(promise).rejects.toThrow(errorClass);
  await expect(promise).rejects.toThrow(pattern);
}

