export class MemoryStore implements Store {
  files: Map<string, string>;
  published: Map<string, string>;
  staged: boolean;
  people: ReadonlySet<string>;
  rev = 0;
  commits: [readonly string[], string][] = [];
  commitResult: Committed = committed({ outcome: CommitOutcome.COMMITTED });
  stamp: string | null = "fetched 2026-10-29T08:00:00+00:00";
  publishes: [Map<string, string>, string][] = [];
  attempts = 0;
  gateFor: Gate | null = null;
  private moves: ReadonlyMap<string, string>[] = [];
  private rejections: ReadonlyMap<string, string>[] = [];

  constructor(
    items: (Area | Decision | SpecEntry)[] = [],
    options: { staged?: boolean; people?: ReadonlySet<string> } = {},
  ) {
    this.people = options.people ?? new Set(["author"]);
    this.files = filesOf(...items);
    this.published = new Map(this.files);
    this.staged = options.staged ?? false;
  }
  async commit(paths: readonly string[], message: string): Promise<Committed> {
    this.commits.push([[...paths], message]);
    return this.commitResult;
  }
  async trees(): Promise<readonly [Tree, Tree]> {
    const current = tree({
      rev: String(this.rev),
      files: new Map(this.files),
      people: this.people,
    });
    const published = this.staged
      ? tree({ rev: String(this.rev), files: new Map(this.published), people: this.people })
      : current;
    const move = this.moves.shift();
    if (move !== undefined) this.land(move);
    return [current, published];
  }
  async attachmentTexts(): Promise<ReadonlyMap<string, string>> {
    return new Map([...this.files].filter(([path]) => path.startsWith(ATTACHMENTS)));
  }
  async freshness(): Promise<string | null> {
    return this.stamp;
  }
  async gate(current: Tree): Promise<Gate> {
    if (this.gateFor !== null) return this.gateFor;
    const published = this.staged
      ? tree({ rev: String(this.rev), files: new Map(this.published), people: this.people })
      : current;
    return gate({ published, checked: [["", current]] });
  }
  async publish(
    base: Tree,
    writes: ReadonlyMap<string, string>,
    message: string,
  ): Promise<PublishOutcome> {
    this.attempts += 1;
    const rejection = this.rejections.shift();
    if (rejection !== undefined) {
      this.land(rejection);
      return PublishOutcome.REJECTED;
    }
    if (base.rev !== String(this.rev)) return PublishOutcome.REJECTED;
    this.publishes.push([new Map(writes), message]);
    this.land(writes);
    return this.staged ? PublishOutcome.STAGED : PublishOutcome.PUBLISHED;
  }
  movesAfterRead(change: ReadonlyMap<string, string>): void {
    this.moves.push(change);
  }
  rejectNext(...changes: ReadonlyMap<string, string>[]): void {
    this.rejections.push(...changes);
  }
  private land(change: ReadonlyMap<string, string>): void {
    for (const [path, text] of change) this.files.set(path, text);
    this.rev += 1;
    if (!this.staged) this.published = new Map(this.files);
  }
}
export class FixedClock implements Clock {
  calls = 0;
  slept: number[] = [];
  constructor(
    public start: Now = START,
    public stepMs = 0,
  ) {}
  now(): Now {
    this.calls += 1;
    return { ...this.start, epochMs: this.start.epochMs + this.stepMs * (this.calls - 1) };
  }
  async sleep(seconds: number): Promise<void> {
    this.slept.push(seconds);
    this.start = { ...this.start, epochMs: this.start.epochMs + seconds * 1000 };
  }
}
export class CountingIds implements IdSource {
  draws = 0;
  next: number;
  constructor(
    first = 1,
    public step = 1,
  ) {
    this.next = first;
  }
  entropy(): Uint8Array {
    this.draws += 1;
    const value = this.next;
    this.next += this.step;
    if (!Number.isInteger(value) || value < 0 || value > 255)
      throw new RangeError("byte must be in range(0, 256)");
    return new Uint8Array(6).fill(value);
  }
}
import { AddOutcome, type Lodge, PublishOutcome, type Store } from "#app";
import type { Tree } from "#core";

class Forwarding implements Store {
  constructor(protected readonly inner: Store) {}
  commit(paths: readonly string[], message: string) {
    return this.inner.commit(paths, message);
  }
  trees() {
    return this.inner.trees();
  }
  attachmentTexts() {
    return this.inner.attachmentTexts();
  }
  freshness() {
    return this.inner.freshness();
  }
  gate(current: Tree) {
    return this.inner.gate(current);
  }
  publish(base: Tree, writes: ReadonlyMap<string, string>, message: string) {
    return this.inner.publish(base, writes, message);
  }
}
export class Interleaved extends Forwarding {
  readonly outcomes: PublishOutcome[] = [];
  private fired = false;
  constructor(
    inner: Store,
    private readonly during: Lodge,
    private readonly drafts: readonly (readonly [string, string])[],
  ) {
    super(inner);
  }
  override async trees(): Promise<readonly [Tree, Tree]> {
    const read = await this.inner.trees();
    if (!this.fired) {
      this.fired = true;
      if ((await this.during.add(this.drafts)).outcome !== AddOutcome.PUBLISHED)
        throw new Error("the interleaved add did not publish");
    }
    return read;
  }
  override async publish(base: Tree, writes: ReadonlyMap<string, string>, message: string) {
    const outcome = await this.inner.publish(base, writes, message);
    this.outcomes.push(outcome);
    return outcome;
  }
}
export class Interleaving extends Forwarding {
  attempts = 0;
  readonly publishes: (readonly [ReadonlyMap<string, string>, string])[] = [];
  private readonly rejections: ReadonlyMap<string, string>[] = [];
  private readonly moves: ReadonlyMap<string, string>[] = [];
  rejectNext(...changes: ReadonlyMap<string, string>[]): void {
    this.rejections.push(...changes);
  }
  movesAfterRead(change: ReadonlyMap<string, string>): void {
    this.moves.push(change);
  }
  async files(): Promise<ReadonlyMap<string, string>> {
    const [current] = await this.inner.trees();
    return new Map([...current.files, ...(await this.inner.attachmentTexts())]);
  }
  private async land(change: ReadonlyMap<string, string>): Promise<void> {
    const [base] = await this.inner.trees();
    if ((await this.inner.publish(base, change, "interleaving")) !== PublishOutcome.PUBLISHED)
      throw new Error("the interleaved change did not publish");
  }
  override async trees(): Promise<readonly [Tree, Tree]> {
    const read = await this.inner.trees();
    const move = this.moves.shift();
    if (move !== undefined) await this.land(move);
    return read;
  }
  override async publish(base: Tree, writes: ReadonlyMap<string, string>, message: string) {
    this.attempts += 1;
    const change = this.rejections.shift();
    if (change !== undefined) await this.land(change);
    const outcome = await this.inner.publish(base, writes, message);
    if (outcome === PublishOutcome.PUBLISHED) this.publishes.push([new Map(writes), message]);
    return outcome;
  }
}
