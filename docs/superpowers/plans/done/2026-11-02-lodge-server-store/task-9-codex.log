  const store = await wrapped(true);
  try { await wired(store).add([["x.md", text]]); throw new Error("expected usage error"); }
  catch(e) { expect(e).toBeInstanceOf(LodgeError); expect(e).not.toBeInstanceOf(Conflict); }
});
