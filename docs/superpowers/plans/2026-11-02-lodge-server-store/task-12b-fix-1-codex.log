  for (const actor of [person("bo"), agent()]) {
    await expect(
      wired(store, new FixedClock(), new CountingIds(), actor).approve(seq),
    ).rejects.toThrow(new Forbidden("only ada approves this; nothing was written"));
  }
  expect(store.files.size).toBe(0);
});
